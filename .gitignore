# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template is meant to be committed
!.env.example

# local SQLite database — holds real booking contact details and fan posts
/.data/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# raw asset dump — not needed to run the site; only the files already
# copied into public/images are actually used
/image assets/
/kazuend-19SC2oaVZW0-unsplash.jpg

# local Claude Code tool settings
.claude/

# Asset staging from the pre-launch compression pass (2026-09-01).
# _originals holds the uncompressed masters of everything in public/, and
# _quarantine holds files nothing references. Both are kept on disk so the
# pass is reversible; neither belongs in git history, which is the whole
# point of having done the pass at all.
/_originals/
/_quarantine/
/_compressed/
